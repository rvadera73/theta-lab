# Theta-Lab Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Schwab API (register at developer.schwab.com — takes 2-5 business days)
SCHWAB_API_KEY=your_api_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_TOKEN_PATH=~/.tokens/schwab_token.json

# Account hashes (get by running: python3 -c "from open_stocks_mcp.tools.schwab_account_tools import get_schwab_account_numbers; print(get_schwab_account_numbers())")
SCHWAB_ACCOUNT_A_HASH=hash_for_account_232_rahul
SCHWAB_ACCOUNT_B_HASH=hash_for_account_275_pinky

# Enable Schwab broker
ENABLED_BROKERS=schwab

# Gmail — for automated weekly dashboard email
# Generate App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ICICI Direct Breeze API (register at https://api.icicidirect.com)
# Session token is daily — set each morning after logging in:
#   1. Visit https://api.icicidirect.com/apiuser/login
#   2. Approve session → copy `apisession` param from redirect URL
BREEZE_API_KEY=your_breeze_api_key_here
BREEZE_API_SECRET=your_breeze_api_secret_here
BREEZE_SESSION_TOKEN=your_daily_session_token_here

# Optional: India regime override (BEAR_SIDEWAYS | TRANSITIONING | BULL)
# INDIA_REGIME_OVERRIDE=BEAR_SIDEWAYS
