# Trade data and financial documents — never commit
data/*.csv
data/*.xlsx
data/*.txt

# Brokerage statements, tax docs, portfolios — stay local only
*.PDF
*.pdf
*.xlsx
*.xls
*Zone.Identifier
*:Zone.Identifier

# Live and paper trade logs
