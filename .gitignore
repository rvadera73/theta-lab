# Trade data and financial documents — never commit
data/**/*.csv
data/**/*.xlsx
data/**/*.txt
data/*.csv
data/*.xlsx
data/*.txt
# Auto-generated snapshots with financial data
data/portfolio_snapshot.yaml

# Dashboard Action Tracker ledger -- runtime state (dashboard/ledger.py),
# not source; would also bloat git history with every status click.
data/dashboard_actions.db

# Real annualized yield-on-capital cache (analysis/premium_yield.py) --
# refreshed once per calendar day, pure runtime state with no historical
# value once superseded; would bloat git history with every day's refresh.
data/premium_yield_cache.json

# Short-TTL (10 min) ticker metrics cache (reports/enhanced_metrics.py) --
# added 2026-10-02 to slow down Yahoo Finance request volume after a real
# rate-limit lockout; pure runtime state, refreshed constantly, no
# historical value.
data/ticker_metrics_cache.json

# flock lockfile for macro_risk_history.yaml's atomic write (2026-10-02 fix)
# -- empty, zero-byte, exists only to hold an flock(); no content ever.
data/*.lock

# Global cross-process Yahoo rate limiter state (mcp/analysis/yahoo_throttle.py,
# 2026-10-04) -- a single shared last-call timestamp + its flock lockfile,
# pure runtime state, rewritten on every yfinance call from any process.
data/.yahoo_rate_limiter_state
data/.yahoo_rate_limiter.lock

# Brokerage statements, tax docs, portfolios — stay local only
*.PDF
*.pdf
*.xlsx
*.xls
*Zone.Identifier
*:Zone.Identifier

# Live and paper trade logs
logs/*.log
logs/*.json
# Action reports are tracked (no sensitive data)
# logs/*.md is intentionally NOT ignored

# Real account configuration
config/accounts.yaml

# Environment and secrets
.env
secrets/
# .env.example IS tracked (template only, no real values)
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
